{
  "name": "rdst-desktop",
  "version": "0.1.0",
  "description": "RDST desktop application",
  "author": {
    "name": "Readyset",
    "email": "support@readyset.io"
  },
  "homepage": "https://readyset.io",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "tsup",
    "build:web": "node ./scripts/build-web.mjs",
    "build:sidecar": "node ./scripts/build-sidecar.mjs",
    "dev": "node ./scripts/dev.mjs",
    "dev:electron": "tsup && (tsup --watch & ELECTRON_RENDERER_URL=${ELECTRON_RENDERER_URL:-http://localhost:3001} electron .)",
    "lock:sidecar": "node ./scripts/lock-sidecar.mjs",
    "package": "node ./scripts/flavor.mjs \"${RDST_DESKTOP_FLAVOR:-release}\" >/dev/null && electron-builder --config \"build/${RDST_DESKTOP_FLAVOR:-release}/electron-builder.yml\" ${RDST_BUILD_VERSION:+-c.extraMetadata.version=\"$RDST_BUILD_VERSION\"}",
    "package:linux": "pnpm prepackage && pnpm package --linux --x64 --publish never",
    "package:mac": "pnpm prepackage && pnpm package --mac --publish never",
    "package:win": "node ./scripts/package-win.mjs",
    "prepackage": "pnpm build:web && pnpm build:sidecar && pnpm build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "pnpm run build && node ./scripts/always-on.e2e.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@rs/typescript-config": "workspace:*",
    "@types/node": "catalog:common",
    "electron": "^40.7.0",
    "electron-builder": "^26.0.12",
    "tsup": "^8.5.0",
    "typescript": "catalog:common",
    "vitest": "^3.2.4"
  }
}
