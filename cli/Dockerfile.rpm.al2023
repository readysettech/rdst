FROM amazonlinux:2023

ENV PYTHON_VERSION=3.11 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

# Toolchain, Python 3.11, packaging bits
RUN dnf -y update && \
    dnf -y install \
        gcc gcc-c++ make cmake which findutils tar zip \
        rpm rpm-build \
        ruby ruby-devel rubygems \
        patchelf \
        zlib-devel openssl-devel libffi-devel pkgconf-pkg-config \
        python3.11 python3.11-devel && \
    (dnf -y install python3.11-pip || python3.11 -m ensurepip) && \
    dnf clean all

# Python toolchain / Nuitka and fpm
RUN python3.11 -m pip install -U pip setuptools wheel && \
    python3.11 -m pip install nuitka zstandard && \
    gem install --no-document fpm && ln -sf /usr/local/bin/fpm /usr/bin/fpm

# Third-party deps used by your code at compile time
COPY requirements.txt /workspace/requirements.txt
RUN python3.11 -m pip install --no-cache-dir -r /workspace/requirements.txt

WORKDIR /workspace
