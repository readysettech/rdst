# PostHog product analytics + session replay (see src/lib/analytics.ts).
# Set as .env to test event flow locally or override the production PostHog
# project. Leave unset to disable analytics in local development. Production
# bundles use the same public, write-only ingest key as the CLI by default.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
