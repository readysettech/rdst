# PostHog product analytics + session replay (see src/lib/analytics.ts).
# Set as .env to test event flow locally. Leave unset to disable analytics
# entirely (local dev default). Release builds receive VITE_POSTHOG_KEY from
# the AWS Secrets Manager secret "frontend/rdst/prod" (json field
# posthog_web_key) — injected by the readyset-rdst Buildkite pipeline,
# never committed.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
