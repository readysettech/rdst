FROM mcr.microsoft.com/playwright:v1.61.0-noble

# The desktop app's runtime libraries (its .deb dependencies), a private
# Secret Service for each run's keychain, a virtual display for Electron, Python
# GObject bindings for the stand-in tray panel, and the Docker CLI for the
# managed Readyset sandbox.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        dbus \
        docker.io \
        gir1.2-glib-2.0 \
        gnome-keyring \
        libasound2t64 \
        libatspi2.0-0t64 \
        libgtk-3-0t64 \
        libnotify4 \
        libnss3 \
        libsecret-1-0 \
        libxss1 \
        libxtst6 \
        python3-gi \
        xdg-utils \
        xvfb \
    && rm -rf /var/lib/apt/lists/*
